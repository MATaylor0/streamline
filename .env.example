# ---------------------------------------------------------------------------
# Streamline configuration. Every variable can also be given as <NAME>_FILE
# pointing at a file containing the value (Docker / Kubernetes secrets).
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8080
# Public URL users reach the app on (required for SSO; enables secure cookies when https).
PUBLIC_URL=https://streamline.example.com
# Set when running behind a load balancer / ingress that sets X-Forwarded-*.
TRUST_PROXY=true
LOG_LEVEL=info

# Database: PostgreSQL for production, SQLite for single-node / evaluation.
DATABASE_URL=postgres://streamline:change-me@postgres:5432/streamline
# DATABASE_URL=sqlite:/data/streamline.db
DATABASE_SSL=disable            # disable | require | verify-full
# DATABASE_SSL_CA=/etc/ssl/certs/rds-ca.pem
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true

# Session signing secret: at least 32 random characters (openssl rand -hex 32).
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# First administrator, created only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DATA=false

# Password sign-in policy.
LOCAL_AUTH_ENABLED=true
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Single sign-on (OpenID Connect): Entra ID, Okta, Auth0, Google, Keycloak, Ping…
# Redirect URI to register with the IdP: ${PUBLIC_URL}/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Microsoft
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAPPING=admin=<group-id>;approver=<group-id>;editor=<group-id>
# OIDC_DEFAULT_ROLE=viewer
# OIDC_AUTO_PROVISION=true

# API / MCP / hardening
MCP_ENABLED=true
API_DOCS_ENABLED=true
CORS_ORIGINS=
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=10
AUDIT_READS=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
